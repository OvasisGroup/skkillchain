# Frontend local overrides
frontend/.env.local

# VPS deploy — infra/docker/.env.prod.example is the checked-in template;
# a real filled-in .env.prod belongs only on the VPS itself (see
# docs/06-devops-security-qa/03-vps-deployment.md), never in git. Same for
# .env.deploy, which deploy.sh writes on the VPS at deploy time.
infra/docker/.env.prod
infra/docker/.env.deploy

