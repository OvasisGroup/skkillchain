# Copy to .env for running the backend directly (outside docker-compose,
# which sets these as container environment variables instead — see
# infra/docker/docker-compose.yml for dev, infra/docker/.env.prod.example
# for the VPS production template).

DJANGO_SETTINGS_MODULE=config.settings.dev

# Required by dev.py has a fallback; stage.py/prod.py require a real value.
SECRET_KEY=change-me

# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://skillchain:skillchain@localhost:5433/skillchain

# Backs the Django cache, the Channels (websocket) layer, AND the Celery
# result backend — one Redis instance, three consumers. See base.py's
# CACHES/CHANNEL_LAYERS.
REDIS_URL=redis://localhost:6380/0

# Celery's broker only (Redis above is the result backend, not this).
CELERY_BROKER_URL=amqp://guest:guest@localhost:5673//

# Comma-separated, required by stage.py/prod.py (dev.py defaults to "*").
ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key for encrypting secrets at rest (MFA TOTP secrets, conferencing
# OAuth tokens). dev.py has a fixed fallback; generate a real one for
# stage/prod with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# OAuth2 social login — expected `aud` claim when verifying provider tokens.
# Leave blank in dev; verification against real providers will simply fail.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Comma-separated. dev.py defaults to the Next.js dev server's port;
# stage.py/prod.py require a real value.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated, scheme+host (e.g. https://api.example.com), required only
# where a session-cookie-authenticated view (chiefly /admin/) sits behind a
# reverse proxy on a domain different from what Django itself resolves the
# request to. Empty is fine in dev and for the JWT-authenticated API itself.
CSRF_TRUSTED_ORIGINS=

# Canonical public URL of the frontend — used to build links in outbound
# emails/notifications, not for CORS/CSRF. Defaults to the Next.js dev
# server if unset.
PUBLIC_APP_URL=http://localhost:3000

# Conferencing OAuth (live sessions) — full authorization-code flow per
# instructor, distinct from GOOGLE_OAUTH_CLIENT_ID above (that one only
# verifies an ID token; this one needs a client secret for the server-side
# token exchange and calendar/meeting scopes). Leave blank in dev.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/v1/instructor/conferencing-accounts/zoom/callback/
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=http://localhost:8000/api/v1/instructor/conferencing-accounts/google_meet/callback/

# --- Payment providers --------------------------------------------------
# All default to "" (provider calls fail with a clear error if attempted
# while unset) — leave blank in dev unless you're actually exercising one.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

PAYSTACK_SECRET_KEY=

# M-Pesa (Safaricom Daraja API) — see apps/commerce/providers/mpesa.py.
# MPESA_CALLBACK_URL must be a publicly reachable HTTPS URL Safaricom can
# call back to; a stale/unreachable value here is a known failure mode
# (payment succeeds on the phone, order never finalizes — see
# docs/06-devops-security-qa/03-vps-deployment.md).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/mpesa/<secret>/

# --- Revenue split -------------------------------------------------------
# Decimal fraction (0.30 = instructors keep 70%) and percent (10.00 = 10%),
# respectively — no documented source of truth beyond these defaults; see
# base.py's PLATFORM_COMMISSION_RATE/AFFILIATE_DEFAULT_COMMISSION_RATE.
PLATFORM_COMMISSION_RATE=0.30
AFFILIATE_DEFAULT_COMMISSION_RATE=10.00

# --- Outbound email -------------------------------------------------------
# dev.py defaults EMAIL_BACKEND to the console backend regardless of this,
# so real SMTP creds are only needed for stage/prod.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@skillchain.example

# --- AI features (course generation assist, chat) ------------------------
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-5
AI_GENERATION_MODEL=claude-sonnet-5
