# Copy to .env for running the backend directly (outside docker-compose,
# which sets these as container environment variables instead — see
# infra/docker/docker-compose.yml).

DJANGO_SETTINGS_MODULE=config.settings.dev

# Required by dev.py has a fallback; stage.py/prod.py require a real value.
SECRET_KEY=change-me

# postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgres://skillchain:skillchain@localhost:5433/skillchain

REDIS_URL=redis://localhost:6380/0

# Comma-separated, required by stage.py/prod.py (dev.py defaults to "*").
ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key for encrypting secrets at rest (MFA TOTP secrets, later
# conferencing OAuth tokens). dev.py has a fixed fallback; generate a real
# one for stage/prod with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# OAuth2 social login — expected `aud` claim when verifying provider tokens.
# Leave blank in dev; verification against real providers will simply fail.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
