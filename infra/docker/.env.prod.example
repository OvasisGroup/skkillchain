# Production environment file for the VPS. Copy to /opt/skillchain/.env.prod
# ONCE during initial setup (see docs/06-devops-security-qa/
# 03-vps-deployment.md) and fill in real values — this file is read both for
# docker-compose.prod.yml's own ${...} interpolation (e.g. ${POSTGRES_DB})
# AND injected verbatim into the api/worker/beat containers via `env_file:`.
#
# NEVER commit the real .env.prod, and note that GitHub Actions never
# transmits this file — it's created and updated by hand on the VPS, not by
# any deploy run. deploy.sh only ever writes IMAGE_TAG into a *separate*
# .env.deploy file alongside this one.

# ---------------------------------------------------------------------------
# Postgres / Redis / RabbitMQ — the compose file's own service credentials.
# ---------------------------------------------------------------------------
# Generate real values, e.g.: openssl rand -hex 24

POSTGRES_DB=skillchain
POSTGRES_USER=skillchain
POSTGRES_PASSWORD=change-me-generate-a-real-secret

REDIS_PASSWORD=change-me-generate-a-real-secret

RABBITMQ_USER=skillchain
RABBITMQ_PASSWORD=change-me-generate-a-real-secret

# Host paths bind-mounted into the api container for media/static (so
# host-nginx can serve them directly — see infra/nginx/skillchain.conf).
# infra/vps/provision.sh creates these, owned by UID 10001 to match the
# backend image's pinned non-root user (see backend/Dockerfile).
MEDIA_HOST_DIR=/opt/skillchain/data/media
STATIC_HOST_DIR=/opt/skillchain/data/static

# ---------------------------------------------------------------------------
# Django — same variables as backend/.env.example, but every *_URL below
# MUST be built from the credentials above by hand: compose's env_file
# loader does not expand ${...} references inside this file the way the
# compose YAML itself does, so these are written out in full rather than
# composed from the vars above. Keep them in sync if you change a password.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.prod

SECRET_KEY=change-me-generate-a-real-secret
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet

# Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
DATABASE_URL=postgres://skillchain:change-me-generate-a-real-secret@postgres:5432/skillchain
# Must match REDIS_PASSWORD above.
REDIS_URL=redis://:change-me-generate-a-real-secret@redis:6379/0
# Must match RABBITMQ_USER/RABBITMQ_PASSWORD above.
CELERY_BROKER_URL=amqp://skillchain:change-me-generate-a-real-secret@rabbitmq:5672//

# The real domains this deploy serves — see infra/nginx/skillchain.conf.
ALLOWED_HOSTS=api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://app.yourdomain.com
PUBLIC_APP_URL=https://app.yourdomain.com

# Google ID-token verification (backend) — must be the SAME client ID as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID passed to the frontend image build (they're
# two ends of the same OAuth client, checked separately: the frontend
# initiates sign-in with it, the backend verifies the token's `aud` claim
# against it).
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Conferencing OAuth (live sessions) — redirect URIs must point at the real
# api domain, not localhost. A stale/unreachable URL here is a known failure
# mode (see docs/06-devops-security-qa/03-vps-deployment.md).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://api.yourdomain.com/api/v1/instructor/conferencing-accounts/zoom/callback/
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=https://api.yourdomain.com/api/v1/instructor/conferencing-accounts/google_meet/callback/

# Payment providers — leave blank to disable a given provider (calls fail
# with a clear error rather than silently misbehaving).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
PAYSTACK_SECRET_KEY=

# M-Pesa — MPESA_CALLBACK_URL must be this deploy's real, publicly reachable
# HTTPS URL. Getting this wrong is the single most common cause of "payment
# succeeded on the phone, order never finalized" (see
# docs/06-devops-security-qa/03-vps-deployment.md).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=production
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=https://api.yourdomain.com/api/v1/webhooks/mpesa/<secret>/

PLATFORM_COMMISSION_RATE=0.30
AFFILIATE_DEFAULT_COMMISSION_RATE=10.00

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-5
AI_GENERATION_MODEL=claude-sonnet-5
