# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Canonical site URL — feeds metadataBase, canonical links, the sitemap,
# and JSON-LD. Set to the real production origin (no trailing slash) when
# deploying; defaults to localhost otherwise.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match the backend's GOOGLE_OAUTH_CLIENT_ID. Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
